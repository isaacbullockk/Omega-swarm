# Omega Swarm Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it is already gitignored

# ─── Server ───
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ─── Database (Required for PostgreSQL) ───
DATABASE_URL=postgresql://user:pass@localhost:5432/omega_swarm

# ─── AI / LLM Providers (Required) ───
OPENAI_API_KEY=sk-your-openai-key-here

# ─── AI / LLM Providers (Optional) ───
GROQ_API_KEY=gsk-your-groq-key-here

# ─── Social Media (Optional — required for Instagram posting) ───
INSTAGRAM_ACCESS_TOKEN=EAAG-your-instagram-token
INSTAGRAM_ACCOUNT_ID=1784-your-account-id
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# ─── Social Scheduling (Optional) ───
BUFFER_API_KEY=1/your-buffer-api-key

# ─── Video Generation (Optional) ───
POLLINATIONS_API_KEY=your-pollinations-key
KLING_API_KEY=your-kling-key

# ─── Monitoring (Optional) ───
SENTRY_DSN=https://your-sentry-dsn
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL